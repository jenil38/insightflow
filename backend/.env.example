# ---- Core ----
ENVIRONMENT=development
DEBUG=true

# ---- Database ----
# SQLite for local dev; use postgres in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/insightflow
DATABASE_URL=sqlite:///./insightflow.db

# ---- Auth / JWT ----
# REQUIRED in production. In dev, an ephemeral secret is generated if missing.
JWT_SECRET=change-me-to-a-random-64-char-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
RESET_TOKEN_EXPIRE_HOURS=1

# ---- CORS ----
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Uploads ----
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ---- Rate limiting ----
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=10/minute

# ---- AI Copilot (Groq) ----
# Leave empty to disable the Copilot feature.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=45

# ---- Email (optional) ----
# Without SMTP_HOST, verification and reset emails are logged to stdout.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@insightflow.ai
FRONTEND_URL=http://localhost:5173
