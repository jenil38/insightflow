# Copy to .env in this directory before running `docker compose up`.
#   cp .env.docker.example .env
#
# POSTGRES_PASSWORD and JWT_SECRET have no defaults - compose fails fast if
# either is missing, rather than silently starting with a weak secret.

# --- Required ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
POSTGRES_PASSWORD=

# --- Database ---
POSTGRES_USER=insightflow
POSTGRES_DB=insightflow

# --- App ---
ENVIRONMENT=production
DEBUG=false

# --- Ports on the host ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- URLs -------------------------------------------------------------------
# VITE_API_BASE is compiled into the frontend bundle at image build time, so
# changing it requires `docker compose build frontend`.
# CORS_ORIGINS must list the exact origin the browser loads the app from.
VITE_API_BASE=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# --- Uploads ---
MAX_UPLOAD_SIZE_MB=50

# --- AI Copilot (optional; empty disables only the Copilot) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Email (optional; empty SMTP_HOST logs emails instead of sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@insightflow.ai
